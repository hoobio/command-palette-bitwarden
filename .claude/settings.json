{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoProfile -Command '& (Join-Path $env:CLAUDE_PROJECT_DIR ''.claude/hooks/Require-DevDeploySkill.ps1'') -Mode Check'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Read",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoProfile -Command '& (Join-Path $env:CLAUDE_PROJECT_DIR ''.claude/hooks/Require-DevDeploySkill.ps1'') -Mode Mark'"
          }
        ]
      }
    ]
  }
}
