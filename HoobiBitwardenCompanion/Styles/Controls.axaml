<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:HoobiBitwardenCompanion.ViewModels">
    <Styles.Resources>
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF1A1F2B" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF1A1F2B" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF1A1F2B" />
        <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FF1A1F2B" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFCBCCC6" />
        <SolidColorBrush x:Key="ComboBoxForegroundPointerOver" Color="#FFCBCCC6" />
        <SolidColorBrush x:Key="ComboBoxForegroundPressed" Color="#FFCBCCC6" />
        <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FFCBCCC6" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2B3140" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="Transparent" />
        <Thickness x:Key="ComboBoxBorderThemeThickness">0</Thickness>
        <Thickness x:Key="ComboBoxDropdownBorderThickness">0</Thickness>
        <Thickness x:Key="ComboBoxDropdownBorderPadding">4</Thickness>
        <Thickness x:Key="ComboBoxDropdownContentMargin">0</Thickness>
        <Thickness x:Key="ComboBoxItemThemePadding">12,6</Thickness>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FF232834" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#FF232834" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FF232834" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#FF232834" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FF73D0FF" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FF73D0FF" />
        <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="#FF73D0FF" />

        <ControlTheme x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
        </ControlTheme>

        <ControlTheme x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#26F28779" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="#40F28779" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="StackListItemTheme" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style Selector="^:nth-child(1) /template/ Border#PART_Root">
                <Setter Property="CornerRadius" Value="8,8,0,0" />
            </Style>
            <Style Selector="^:nth-last-child(1) /template/ Border#PART_Root">
                <Setter Property="CornerRadius" Value="0,0,8,8" />
            </Style>
            <Style Selector="^:nth-child(1):nth-last-child(1) /template/ Border#PART_Root">
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="CaptionButtonTheme" TargetType="Button" BasedOn="{StaticResource FluentDrawnCaptionButton}">
            <Setter Property="Width" Value="{StaticResource CaptionButtonWidth}" />
            <Style Selector="^.Close:pointerover /template/ Border">
                <Setter Property="Background" Value="{DynamicResource CaptionCloseBackgroundPointerOver}" />
            </Style>
            <Style Selector="^.Close:pressed /template/ Border">
                <Setter Property="Background" Value="{DynamicResource CaptionCloseBackgroundPressed}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="HoobiWindowDecorations" TargetType="chrome:WindowDrawnDecorations" BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
            <Setter Property="Template">
                <WindowDrawnDecorationsTemplate>
                    <chrome:WindowDrawnDecorationsContent>
                        <chrome:WindowDrawnDecorationsContent.Underlay>
                            <Panel Name="PART_UnderlayWrapper">
                                <Border
                                    Name="PART_WindowBorder"
                                    Background="Transparent"
                                    BorderThickness="{TemplateBinding FrameThickness}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False" />
                                <Panel
                                    Name="PART_TitleBar"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="Transparent"
                                    IsVisible="{TemplateBinding HasTitleBar}"
                                    chrome:WindowDecorationProperties.ElementRole="TitleBar" />
                            </Panel>
                        </chrome:WindowDrawnDecorationsContent.Underlay>
                        <chrome:WindowDrawnDecorationsContent.Overlay>
                            <Panel Name="PART_OverlayWrapper">
                                <StackPanel
                                    Name="PART_OverlayPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    IsVisible="{TemplateBinding HasTitleBar}">
                                    <Button
                                        Name="PART_MinimizeButton"
                                        Classes="CaptionButton"
                                        Theme="{StaticResource CaptionButtonTheme}"
                                        Content="&#xE738;"
                                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton" />
                                    <Button
                                        Name="PART_MaximizeButton"
                                        Classes="CaptionButton"
                                        Theme="{StaticResource CaptionButtonTheme}"
                                        Content="&#xE739;"
                                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton" />
                                    <Button
                                        Name="PART_CloseButton"
                                        Classes="CaptionButton Close"
                                        Theme="{StaticResource CaptionButtonTheme}"
                                        FontSize="16"
                                        Content="&#xE711;"
                                        chrome:WindowDecorationProperties.ElementRole="CloseButton" />
                                </StackPanel>
                            </Panel>
                        </chrome:WindowDrawnDecorationsContent.Overlay>
                    </chrome:WindowDrawnDecorationsContent>
                </WindowDrawnDecorationsTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="HoobiCloseOnlyDecorations" TargetType="chrome:WindowDrawnDecorations" BasedOn="{StaticResource {x:Type chrome:WindowDrawnDecorations}}">
            <Setter Property="Template">
                <WindowDrawnDecorationsTemplate>
                    <chrome:WindowDrawnDecorationsContent>
                        <chrome:WindowDrawnDecorationsContent.Underlay>
                            <Panel Name="PART_UnderlayWrapper">
                                <Border
                                    Name="PART_WindowBorder"
                                    Background="Transparent"
                                    BorderThickness="{TemplateBinding FrameThickness}"
                                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    IsHitTestVisible="False" />
                                <Panel
                                    Name="PART_TitleBar"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    Background="Transparent"
                                    IsVisible="{TemplateBinding HasTitleBar}"
                                    chrome:WindowDecorationProperties.ElementRole="TitleBar" />
                            </Panel>
                        </chrome:WindowDrawnDecorationsContent.Underlay>
                        <chrome:WindowDrawnDecorationsContent.Overlay>
                            <Panel Name="PART_OverlayWrapper">
                                <StackPanel
                                    Name="PART_OverlayPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Height="{TemplateBinding TitleBarHeight}"
                                    IsVisible="{TemplateBinding HasTitleBar}">
                                    <Button
                                        Name="PART_CloseButton"
                                        Classes="CaptionButton Close"
                                        Theme="{StaticResource CaptionButtonTheme}"
                                        FontSize="16"
                                        Content="&#xE711;"
                                        chrome:WindowDecorationProperties.ElementRole="CloseButton" />
                                </StackPanel>
                            </Panel>
                        </chrome:WindowDrawnDecorationsContent.Overlay>
                    </chrome:WindowDrawnDecorationsContent>
                </WindowDrawnDecorationsTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector=":is(TopLevel)">
        <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextForegroundThemeBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource ControlContentThemeFontSize}" />
    </Style>

    <Style Selector="Button.CaptionButton">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <Style Selector="ListBox.Rail, ListBox.Stack">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.Rail ListBoxItem" x:DataType="vm:FilterViewModel">
        <Setter Property="IsEnabled" Value="{Binding !IsHeader}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <Style Selector="ItemsControl.Stack">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="1" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <Style Selector="Border.StackRow">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    </Style>

    <Style Selector="ItemsControl.Stack > ContentPresenter:nth-child(1) Border.StackRow">
        <Setter Property="CornerRadius" Value="8,8,0,0" />
    </Style>

    <Style Selector="ItemsControl.Stack > ContentPresenter:nth-last-child(1) Border.StackRow">
        <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>

    <Style Selector="ItemsControl.Stack > ContentPresenter:nth-child(1):nth-last-child(1) Border.StackRow">
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <Style Selector="StackPanel.Stack">
        <Setter Property="Spacing" Value="1" />
    </Style>

    <Style Selector="StackPanel.Stack > Border.StackRow">
        <Setter Property="Padding" Value="{StaticResource CardRowPadding}" />
    </Style>

    <Style Selector="StackPanel.Stack > Border.StackRow:nth-child(1)">
        <Setter Property="CornerRadius" Value="8,8,0,0" />
    </Style>

    <Style Selector="StackPanel.Stack > Border.StackRow:nth-last-child(1)">
        <Setter Property="CornerRadius" Value="0,0,8,8" />
    </Style>

    <Style Selector="StackPanel.Stack > Border.StackRow:nth-child(1):nth-last-child(1)">
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <Style Selector="Border.StackRow TextBox">
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.StackRow ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource ControlContentThemeFontSize}" />
    </Style>

    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="BoxShadow" Value="0 8 16 0 #47000000, 0 0 2 0 #3D000000" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <Style Selector="ComboBoxItem /template/ Border#LayoutRoot">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="ComboBoxItem /template/ Rectangle#Pill">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TextBlock.GroupHeader">
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.RowLabel">
        <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DefaultTextForegroundThemeBrush}" />
    </Style>

    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.Danger">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <Style Selector="ui|FAContentDialog.Action /template/ Button#SecondaryButton">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="Foreground" Value="#FF1A1F2B" />
    </Style>

    <Style Selector="ui|FAContentDialog.Action /template/ Button#SecondaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFF49B8F" />
        <Setter Property="Foreground" Value="#FF1A1F2B" />
    </Style>

    <Style Selector="TextBlock.Icon">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
    </Style>
</Styles>
