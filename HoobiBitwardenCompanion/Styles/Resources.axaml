    <SolidColorBrush x:Key="CaptionButtonForeground" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="CaptionButtonForegroundInactive" Color="#FF707A8C" />
    <SolidColorBrush x:Key="CaptionButtonForegroundPointerOver" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="CaptionButtonForegroundPressed" Color="#FFCBCCC6" />
