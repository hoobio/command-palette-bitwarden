<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ContentControlThemeFontFamily">avares://HoobiBitwardenCompanion/Assets/Fonts#Hanken Grotesk</FontFamily>
    <FontFamily x:Key="MonoFontFamily">avares://HoobiBitwardenCompanion/Assets/Fonts#Cascadia Mono</FontFamily>

    <Color x:Key="SystemAccentColor">#FF409FFF</Color>
    <Color x:Key="SystemAccentColorLight1">#FF73D0FF</Color>
    <Color x:Key="SystemAccentColorLight2">#FF73D0FF</Color>
    <Color x:Key="SystemAccentColorLight3">#FF73D0FF</Color>

    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FFBAE67E" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFFD580" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFF28779" />

    <SolidColorBrush x:Key="WindowGroundBrush" Color="#FF1F2430" />
    <SolidColorBrush x:Key="ChipBrush" Color="#FF1A1F2B" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF1F2430" />
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF1F2430" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF232834" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF2B3140" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF8A9199" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF707A8C" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF4E5768" />
    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF73D0FF" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF409FFF" />

    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="RowHairlineBrush" Color="#FF1F2430" />

    <SolidColorBrush x:Key="ButtonBackground" Color="#FF1A1F2B" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF2B3140" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF1A1F2B" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF1A1F2B" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF4E5768" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF409FFF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF73D0FF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF73D0FF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FF2F5A85" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF1F2430" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF1F2430" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF1F2430" />
    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF8FB8DD" />

    <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF2B3140" />
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#B3000000" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FF2B3140" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent" />

    <SolidColorBrush x:Key="TextControlBackground" Color="#FF1A1F2B" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF1A1F2B" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF1A1F2B" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF343B4C" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF343B4C" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF409FFF" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFCBCCC6" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF707A8C" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#FF707A8C" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF707A8C" />

    <SolidColorBrush x:Key="CaptionButtonBackground" Color="#00191919" />
    <SolidColorBrush x:Key="CaptionButtonBackgroundInactive" Color="#00191919" />
    <SolidColorBrush x:Key="CaptionButtonBackgroundPointerOver" Color="#FF191919" />
    <SolidColorBrush x:Key="CaptionButtonBackgroundPressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonForegroundInactive" Color="#FF666666" />
    <SolidColorBrush x:Key="CaptionButtonForegroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonForegroundPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CaptionCloseBackgroundPointerOver" Color="#FFE81123" />
    <SolidColorBrush x:Key="CaptionCloseBackgroundPressed" Color="#E6C42B1C" />

    <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
    <x:Double x:Key="CaptionTextBlockFontSize">12</x:Double>
    <x:Double x:Key="BodyTextBlockFontSize">14</x:Double>
    <x:Double x:Key="SubtitleTextBlockFontSize">20</x:Double>
    <Thickness x:Key="ButtonPadding">13,4,13,4</Thickness>
    <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <x:Double x:Key="CaptionButtonWidth">48</x:Double>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <Thickness x:Key="PageGutter">24,8,24,24</Thickness>
    <Thickness x:Key="CardRowPadding">16,10</Thickness>
    <x:Double x:Key="ContentDialogMinWidth">400</x:Double>
    <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
    <Thickness x:Key="ContentDialogPadding">24</Thickness>
</ResourceDictionary>
