<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ContentControlThemeFontFamily">avares://HoobiBitwardenCompanion/Assets/Fonts#Hanken Grotesk</FontFamily>
    <FontFamily x:Key="MonoFontFamily">avares://HoobiBitwardenCompanion/Assets/Fonts#Cascadia Mono</FontFamily>

    <Color x:Key="SystemAccentColor">#FF409FFF</Color>
    <Color x:Key="SystemAccentColorLight1">#FF73D0FF</Color>
    <Color x:Key="SystemAccentColorLight2">#FF73D0FF</Color>
    <Color x:Key="SystemAccentColorLight3">#FF73D0FF</Color>

    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FFBAE67E" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFFD580" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFF28779" />
    <SolidColorBrush x:Key="AlertWarnFillBrush" Color="#26FFD580" />

    <SolidColorBrush x:Key="WindowGroundBrush" Color="#FF181C26" />
