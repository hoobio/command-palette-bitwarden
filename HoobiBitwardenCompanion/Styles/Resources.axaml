    <SolidColorBrush x:Key="CaptionCloseBackgroundPressed" Color="#E6C42B1C" />

    <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
    <x:Double x:Key="CaptionTextBlockFontSize">12</x:Double>
    <x:Double x:Key="BodyTextBlockFontSize">14</x:Double>
    <x:Double x:Key="SubtitleTextBlockFontSize">20</x:Double>
    <Thickness x:Key="ButtonPadding">12,0</Thickness>
    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
    <Thickness x:Key="TextControlThemePadding">10,6</Thickness>
    <x:Double x:Key="TextControlThemeMinHeight">32</x:Double>
    <x:Double x:Key="TitleBarHeight">48</x:Double>
    <x:Double x:Key="CaptionButtonWidth">46</x:Double>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <Thickness x:Key="PageGutter">0,0,24,24</Thickness>
    <Thickness x:Key="CardRowPadding">16,10,8,10</Thickness>
    <x:Double x:Key="ContentDialogMaxWidth">400</x:Double>
    <BoxShadows x:Key="FlyoutShadow">0 8 16 0 #47000000, 0 0 2 0 #3D000000</BoxShadows>
</ResourceDictionary>
