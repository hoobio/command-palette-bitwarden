    <GridLength x:Key="ToggleSwitchPostContentMargin">0</GridLength>

    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FF242936" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="Transparent" />
