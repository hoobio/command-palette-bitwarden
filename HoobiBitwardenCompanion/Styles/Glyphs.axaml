<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="IconFontFamily">avares://HoobiBitwardenCompanion/Assets/Fonts#FluentSystemIcons-Resizable</FontFamily>

    <x:String x:Key="Glyph.Eye">&#xE883;</x:String>
    <x:String x:Key="Glyph.EyeOff">&#xE889;</x:String>
    <x:String x:Key="Glyph.Copy">&#xE5D7;</x:String>
    <x:String x:Key="Glyph.Open">&#xECF4;</x:String>
    <x:String x:Key="Glyph.Lock">&#xEBAC;</x:String>
    <x:String x:Key="Glyph.ChevronUp">&#xE490;</x:String>
    <x:String x:Key="Glyph.ChevronDown">&#xE488;</x:String>
    <x:String x:Key="Glyph.Add">&#xE00D;</x:String>
    <x:String x:Key="Glyph.Delete">&#xE66D;</x:String>
</ResourceDictionary>
