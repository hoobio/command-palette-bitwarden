<Application
    x:Class="HoobiBitwardenCompanion.App"
    Name="Bitwarden"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hoobi="using:Hoobi.Design.Avalonia"
    RequestedThemeVariant="Dark">
    <Application.Styles>
        <hoobi:HoobiTheme />
        <Style Selector="Window">
            <Setter Property="Icon" Value="avares://HoobiBitwardenCompanion/Assets/app.ico" />
        </Style>
    </Application.Styles>
</Application>
