<UserControl
    x:Class="HoobiBitwardenCompanion.Views.SettingRowBody"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ipc="using:HoobiBitwarden.Ipc"
    xmlns:vm="using:HoobiBitwardenCompanion.ViewModels"
    x:DataType="vm:SettingRowViewModel">
    <StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsPlain}">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <WrapPanel>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                    <TextBlock Classes="Icon" Margin="8,0,0,0" FontSize="14" Text="{StaticResource Glyph.CheckMark}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" IsVisible="{Binding IsStatusOk}" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}" />
                    <TextBlock Classes="Icon" Margin="8,0,0,0" FontSize="14" Text="{StaticResource Glyph.Warning}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" IsVisible="{Binding IsStatusError}" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Tooltip}" />
                </WrapPanel>
                <TextBlock Classes="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" MinWidth="0" VerticalAlignment="Center" IsVisible="{Binding IsToggle}" IsChecked="{Binding BoolValue, Mode=TwoWay}" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.Name="{Binding Label}" />
            <ComboBox Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding IsChoice}" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="ipc:ChoiceDto">
                        <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Description}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <StackPanel Spacing="6" IsVisible="{Binding IsText}">
            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
            <TextBlock Classes="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
            <TextBox Text="{Binding TextValue, Mode=OneWay}" IsReadOnly="{Binding IsReadOnly}" IsEnabled="{Binding !IsReadOnly}" PlaceholderText="{Binding Placeholder}" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Label}" />
        </StackPanel>
        <TextBlock Classes="Warn" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>
