<UserControl
    x:Class="HoobiBitwardenCompanion.Views.ItemView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HoobiBitwardenCompanion.ViewModels"
    xmlns:views="using:HoobiBitwardenCompanion.Views"
    x:DataType="vm:ItemViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemHeader" x:DataType="vm:ItemViewModel">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,0,8,12">
                <Border Classes="Tile Large">
                    <Panel>
                        <Image Source="{Binding Icon}" Width="32" Height="32" IsVisible="{Binding HasIcon}" />
                        <TextBlock Classes="Icon Accent" Text="{Binding TypeGlyph}" FontSize="24" HorizontalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="{StaticResource SubtitleTextBlockFontSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,2,0,0" ItemSpacing="6" LineSpacing="6">
                        <Border Classes="Badge">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="OrganizationName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Organization}" />
                                <TextBlock Text="{Binding OrganizationName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="FolderName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Folder}" />
                                <TextBlock Text="{Binding FolderName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge Accent">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="IsFavorite" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.StarFilled}" />
                                <TextBlock Text="Favourite" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="IsProtected" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Lock}" />
                                <TextBlock Text="Protected" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge Accent" IsVisible="{Binding IsEditing}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Edit}" />
                                <TextBlock Text="Editing" VerticalAlignment="Center" IsVisible="{Binding !IsNew}" />
                                <TextBlock Text="New item" VerticalAlignment="Center" IsVisible="{Binding IsNew}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ContentControl.VaultHeader, Panel.VaultOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="views|ItemView.InVault ContentControl.VaultHeader, views|ItemView.InVault Panel.VaultOnly">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="views|ItemView.InVault ContentControl.WindowHeader">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="views|ItemView.InVault ItemsControl#GroupList > ContentPresenter:nth-child(1) TextBlock.GroupHeader">
            <Setter Property="Margin" Value="4,8,4,8" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <ContentControl Classes="VaultHeader" Content="{Binding}" ContentTemplate="{StaticResource ItemHeader}" Margin="0,0,16,0" />

        <Grid x:Name="Toolbar" Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,24,4">
            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button x:Name="RestoreButton" Content="Restore" Command="{Binding RestoreCommand}" IsVisible="{Binding CanRestore}" />
                <Button x:Name="EditButton" Content="Edit" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" />
                <Panel Classes="VaultOnly">
                    <Button x:Name="CloneButton" Content="Clone" Command="{Binding CloneCommand}" IsVisible="{Binding CanEdit}" />
                </Panel>
                <Button x:Name="HistoryButton" Content="Password history" Command="{Binding ShowPasswordHistoryCommand}" IsVisible="{Binding CanShowHistory}" />
                <Button x:Name="RotateButton" Content="Rotate password" Command="{Binding RotateCommand}" IsVisible="{Binding CanRotate}" />
                <Button x:Name="SaveButton" Theme="{StaticResource AccentButtonStyle}" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding IsEditing}" />
                <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditing}" />
            </WrapPanel>
            <Panel Grid.Column="1" Classes="VaultOnly" VerticalAlignment="Top">
                <Button x:Name="OpenWindowButton" Theme="{StaticResource GhostButtonStyle}" Command="{Binding $parent[views:ItemView].OpenInWindowCommand}" IsVisible="{Binding IsReadOnly}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="Icon" Text="{StaticResource Glyph.WindowNew}" FontSize="16" />
                        <TextBlock Text="Open in own window" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Panel>
            <Button x:Name="DeleteButton" Grid.Column="2" VerticalAlignment="Top" Theme="{StaticResource DangerIconButtonStyle}" Content="{StaticResource Glyph.Delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" ToolTip.Tip="{Binding DeleteLabel}" AutomationProperties.Name="{Binding DeleteLabel}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,24,0">
            <Border x:Name="ErrorBanner" Classes="Banner" Margin="0,4,0,8" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Classes="Icon" Text="{StaticResource Glyph.Warning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Top" />
                    <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                </Grid>
            </Border>
            <Border Classes="Banner" Margin="0,4,0,8" IsVisible="{Binding Editor.FormMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Classes="Icon" Text="{StaticResource Glyph.Warning}" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Top" />
                    <TextBlock x:Name="ValidationText" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Editor.FormMessage, FallbackValue={x:Null}}" />
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="3" IsVisible="{Binding !IsEditing}">
            <StackPanel Margin="{StaticResource PageGutter}">
                <ContentControl Classes="WindowHeader" Content="{Binding}" ContentTemplate="{StaticResource ItemHeader}" Margin="0,8,-8,0" />

                <Border Classes="Group" Margin="0,8,0,0" IsVisible="{Binding RepromptRequired}">
                    <Border Classes="Row" Padding="16,20">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="Icon" Text="{StaticResource Glyph.Lock}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="This item is protected" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="Caption" FontSize="13" TextWrapping="Wrap" Text="Enter your master password to view and copy this item." />
                            <Button x:Name="VerifyButton" Margin="0,8,0,0" Theme="{StaticResource AccentButtonStyle}" Content="Verify master password" Click="OnVerifyClick" />
                        </StackPanel>
                    </Border>
                </Border>

                <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldGroupViewModel">
                            <StackPanel>
                                <TextBlock Classes="GroupHeader" Text="{Binding Name}" />
                                <Border Classes="Group">
                                    <ItemsControl Classes="Rows" ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FieldViewModel">
                                                <Panel>
                                                    <Border Classes="Row KeyValue" IsVisible="{Binding !CanCopy}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" TextElement.FontSize="13">
                                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Classes="Row Field" IsVisible="{Binding CanCopy}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Classes="FieldLabel" Text="{Binding Label}" />
                                                                <TextBlock
                                                                    Text="{Binding DisplayValue}"
                                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                                    FontSize="20"
                                                                    LetterSpacing="1"
                                                                    IsVisible="{Binding IsTotp}" />
                                                                <TextBlock
                                                                    Text="{Binding DisplayValue}"
                                                                    TextWrapping="Wrap"
                                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                                    FontSize="13"
                                                                    LetterSpacing="1"
                                                                    IsVisible="{Binding IsSecret}" />
                                                                <SelectableTextBlock
                                                                    Text="{Binding DisplayValue}"
                                                                    TextWrapping="Wrap"
                                                                    IsVisible="{Binding IsPlain}" />
                                                                <SelectableTextBlock
                                                                    Text="{Binding DisplayValue}"
                                                                    TextWrapping="Wrap"
                                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                                    FontSize="13"
                                                                    IsVisible="{Binding IsMono}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Panel Classes="Ring" Classes.Warn="{Binding IsTotpExpiring}" Margin="0,0,4,0" IsVisible="{Binding IsTotp}">
                                                                    <Ellipse Margin="1.5" Stroke="{DynamicResource TextControlBorderBrush}" StrokeThickness="3" />
                                                                    <Arc Margin="1.5" StartAngle="-90" SweepAngle="{Binding TotpSweep}" StrokeThickness="3" StrokeLineCap="Round" />
                                                                    <TextBlock Text="{Binding TotpRemaining}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Panel>
                                                                <Button Theme="{StaticResource IconButtonStyle}" Command="{Binding ToggleRevealCommand}" IsVisible="{Binding IsSecret}" ToolTip.Tip="Show or hide">
                                                                    <Panel>
                                                                        <TextBlock Text="{StaticResource Glyph.Eye}" IsVisible="{Binding !IsRevealed}" />
                                                                        <TextBlock Classes="Icon Accent" Text="{StaticResource Glyph.EyeOff}" IsVisible="{Binding IsRevealed}" />
                                                                    </Panel>
                                                                </Button>
                                                                <Button Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Open}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" ToolTip.Tip="Open in browser" />
                                                                <Button Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Copy}" Command="{Binding CopyCommand}" ToolTip.Tip="Copy" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="AttachmentsGroup" IsVisible="{Binding ShowAttachments}">
                    <TextBlock Classes="GroupHeader" Text="Attachments" />
                    <Border Classes="Group">
                        <StackPanel Classes="Rows">
                            <ItemsControl x:Name="AttachmentList" Classes="Rows" ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AttachmentViewModel">
                                        <Border Classes="Row Field">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                <TextBlock Classes="Icon" Text="{StaticResource Glyph.Document}" />
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="FieldLabel" Text="{Binding SizeName}" IsVisible="{Binding SizeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Download}" Command="{Binding DownloadCommand}" ToolTip.Tip="Download" AutomationProperties.Name="Download" />
                                                <Button Grid.Column="3" Margin="-8,0,0,0" Theme="{StaticResource DangerIconButtonStyle}" Content="{StaticResource Glyph.Delete}" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete attachment" AutomationProperties.Name="Delete attachment" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="AddAttachmentButton" Theme="{StaticResource AddRowButtonStyle}" Command="{Binding AddAttachmentCommand}" IsVisible="{Binding CanAttach}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="Icon" Text="{StaticResource Glyph.Add}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Add attachment" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="EditorScroll" Grid.Row="3" IsVisible="{Binding IsEditing}">
            <views:ItemEditView x:Name="EditView" Margin="{StaticResource PageGutter}" DataContext="{Binding Editor}" />
        </ScrollViewer>

        <TextBlock
            Grid.Row="4"
            Classes="Caption"
            Margin="0,0,24,12"
            Text="{Binding StatusMessage}"
            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Grid>
</UserControl>
