<UserControl
    x:Class="HoobiBitwardenCompanion.Views.ItemView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vm="using:HoobiBitwardenCompanion.ViewModels"
    xmlns:views="using:HoobiBitwardenCompanion.Views"
    x:DataType="vm:ItemViewModel">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemHeader" x:DataType="vm:ItemViewModel">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,0,8,12">
                <Border Classes="Tile Large">
                    <Panel>
                        <Image Source="{Binding Icon}" Width="32" Height="32" IsVisible="{Binding HasIcon}" />
                        <TextBlock Classes="Icon Accent" Text="{Binding TypeGlyph}" FontSize="24" HorizontalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="{StaticResource SubtitleTextBlockFontSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,2,0,0" ItemSpacing="6" LineSpacing="6">
                        <Border Classes="Badge">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="OrganizationName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Organization}" />
                                <TextBlock Text="{Binding OrganizationName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="FolderName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Folder}" />
                                <TextBlock Text="{Binding FolderName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge Accent">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="IsFavorite" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.StarFilled}" />
                                <TextBlock Text="Favourite" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="IsProtected" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Lock}" />
                                <TextBlock Text="Protected" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="NewItemBadge" Classes="Badge Accent" IsVisible="{Binding IsNew}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Add}" />
                                <TextBlock Text="New item" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge Accent">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsEditing" />
                                    <Binding Path="!IsNew" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Edit}" />
                                <TextBlock Text="Editing" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <ContentControl x:Name="Header" Margin="0,0,24,0" Content="{Binding}" ContentTemplate="{StaticResource ItemHeader}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,24,16" IsVisible="{Binding IsEditing}">
            <Button x:Name="SaveButton" Theme="{StaticResource AccentButtonStyle}" Content="Save" Command="{Binding SaveCommand}" />
            <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelEditCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,24,0">
            <StackPanel x:Name="BusyPanel" Spacing="6" Margin="0,4,0,8" IsVisible="{Binding IsBusy}">
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" />
                <TextBlock x:Name="BusyText" Classes="Caption" TextWrapping="Wrap" Text="{Binding BusyMessage}" />
            </StackPanel>
            <Border x:Name="ErrorAlert" Classes="Alert" Classes.Danger="{Binding IsWriteFailure}" Margin="0,4,0,8" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <TextBlock Classes="Icon" Text="{StaticResource Glyph.Warning}" FontSize="18" VerticalAlignment="Top" IsVisible="{Binding IsWriteFailure}" />
                    <TextBlock x:Name="ErrorText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding ErrorMessage}" />
                </Grid>
            </Border>
            <Border x:Name="StatusAlert" Classes="Alert" Margin="0,4,0,8" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}" />
            </Border>
            <Border Classes="Alert" Margin="0,4,0,8" IsVisible="{Binding Editor.FormMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Text="{Binding Editor.FormMessage, FallbackValue={x:Null}}" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" IsVisible="{Binding !IsEditing}">
            <StackPanel Margin="{StaticResource PageGutter}">
                <Border x:Name="PasswordPanel" Classes="Group" Margin="0,8,0,0" IsVisible="{Binding IsPrompting}">
                    <Border Classes="Row" Padding="16,20">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="Icon" Text="{StaticResource Glyph.Lock}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Master password required" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox x:Name="PasswordBox" Classes="revealPasswordButton" PasswordChar="•" PlaceholderText="Master password" IsEnabled="{Binding !IsVerifying}" KeyDown="OnPasswordKeyDown" />
                            <TextBlock x:Name="PasswordErrorText" Classes="Caption Warn" TextWrapping="Wrap" Text="{Binding PasswordError}" IsVisible="{Binding PasswordError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,*">
                                <Button x:Name="VerifyButton" Theme="{StaticResource AccentButtonStyle}" IsEnabled="{Binding !IsVerifying}" Click="OnVerifyClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <ui:FAProgressRing x:Name="VerifyRing" Width="14" Height="14" IsIndeterminate="True" IsVisible="{Binding IsVerifying}" />
                                        <TextBlock Text="Verify" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BiometricButton" Grid.Column="1" HorizontalAlignment="Right" IsVisible="{Binding BiometricAvailable}" IsEnabled="{Binding !IsVerifying}" Click="OnBiometricClick" ToolTip.Tip="Verify with Windows Hello">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="Icon" Text="{StaticResource Glyph.Fingerprint}" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Verify with Windows Hello" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Border>
                </Border>

                <StackPanel x:Name="GracePanel" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding GraceVisible}">
                    <ProgressBar x:Name="GraceBar" Height="3" Minimum="0" Maximum="1" Value="{Binding GraceFraction}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="GraceText" Classes="Caption" Text="{Binding GraceCaption}" VerticalAlignment="Center" />
                        <Button x:Name="KeepOpenButton" Grid.Column="1" Theme="{StaticResource CaptionLinkButtonStyle}" Content="Keep open" Command="{Binding KeepOpenCommand}" />
                    </Grid>
                </StackPanel>

                <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}" IsVisible="{Binding !IsPrompting}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldGroupViewModel">
                            <StackPanel>
                                <TextBlock Classes="GroupHeader" Text="{Binding Name}" />
                                <Border Classes="Group">
                                    <ItemsControl Classes="Rows" ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FieldViewModel">
                                                <Panel>
                                                    <Border Classes="Row KeyValue" IsVisible="{Binding !CanCopy}">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" TextElement.FontSize="13">
                                                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayValue}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Border>
                                                    <Border Classes="Row Field" IsVisible="{Binding CanCopy}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Classes="FieldLabel" Text="{Binding Label}" VerticalAlignment="Center" />
                                                                    <Button x:Name="RotateButton" Theme="{StaticResource CaptionLinkButtonStyle}" Content="Rotate" Command="{Binding RotateCommand}" IsVisible="{Binding CanRotate}" ToolTip.Tip="Replace this password" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Text="{Binding DisplayValue}"
                                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                                    FontSize="20"
                                                                    LetterSpacing="1"
                                                                    IsVisible="{Binding IsTotp}" />
                                                                <TextBlock
                                                                    Text="{Binding DisplayValue}"
                                                                    TextWrapping="Wrap"
                                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                                    FontSize="13"
                                                                    LetterSpacing="1"
                                                                    IsVisible="{Binding IsFixedSecret}" />
                                                                <SelectableTextBlock
                                                                    Text="{Binding DisplayValue}"
                                                                    TextWrapping="Wrap"
                                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                                    FontSize="13"
                                                                    LetterSpacing="1"
                                                                    IsVisible="{Binding IsSelectableSecret}" />
                                                                <SelectableTextBlock
                                                                    Text="{Binding DisplayValue}"
                                                                    TextWrapping="Wrap"
                                                                    IsVisible="{Binding IsPlain}" />
                                                                <SelectableTextBlock
                                                                    Text="{Binding DisplayValue}"
                                                                    TextWrapping="Wrap"
                                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                                    FontSize="13"
                                                                    IsVisible="{Binding IsMono}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Panel Classes="Ring" Classes.Warn="{Binding IsTotpExpiring}" Margin="0,0,4,0" IsVisible="{Binding IsTotp}">
                                                                    <Ellipse Margin="1.5" Stroke="{DynamicResource TextControlBorderBrush}" StrokeThickness="3" />
                                                                    <Arc Margin="1.5" StartAngle="-90" SweepAngle="{Binding TotpSweep}" StrokeThickness="3" StrokeLineCap="Round" />
                                                                    <TextBlock Text="{Binding TotpRemaining}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Panel>
                                                                <Button Theme="{StaticResource IconButtonStyle}" Command="{Binding ToggleRevealCommand}" IsVisible="{Binding IsSecret}" ToolTip.Tip="Show or hide">
                                                                    <Panel>
                                                                        <TextBlock Text="{StaticResource Glyph.Eye}" IsVisible="{Binding !IsRevealed}" />
                                                                        <TextBlock Classes="Icon Accent" Text="{StaticResource Glyph.EyeOff}" IsVisible="{Binding IsRevealed}" />
                                                                    </Panel>
                                                                </Button>
                                                                <Button Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Open}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" ToolTip.Tip="Open in browser" />
                                                                <Button Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Copy}" Command="{Binding CopyCommand}" ToolTip.Tip="Copy" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Panel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="PasswordHistoryGroup" IsVisible="{Binding CanShowHistory}">
                    <TextBlock Classes="GroupHeader" Text="Password history" />
                    <Border Classes="Group">
                        <Button x:Name="HistoryButton" Theme="{StaticResource AddRowButtonStyle}" Command="{Binding ShowPasswordHistoryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Panel Width="16">
                                    <TextBlock Classes="Icon" Text="{StaticResource Glyph.Password}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" IsVisible="{Binding !ShowPasswordHistoryCommand.IsRunning}" />
                                    <ui:FAProgressRing x:Name="HistoryRing" Width="14" Height="14" IsIndeterminate="True" IsVisible="{Binding ShowPasswordHistoryCommand.IsRunning}" />
                                </Panel>
                                <TextBlock Text="Show password history" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AttachmentsGroup" IsVisible="{Binding ShowAttachments}">
                    <TextBlock Classes="GroupHeader" Text="Attachments" />
                    <Border Classes="Group">
                        <StackPanel Classes="Rows">
                            <ItemsControl x:Name="AttachmentList" Classes="Rows" ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AttachmentViewModel">
                                        <Border Classes="Row Field">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                <TextBlock Classes="Icon" Text="{StaticResource Glyph.Document}" />
                                                <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="FieldLabel" Text="{Binding SizeName}" IsVisible="{Binding SizeName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Download}" Command="{Binding DownloadCommand}" ToolTip.Tip="Download" AutomationProperties.Name="Download" />
                                                <Button Grid.Column="3" Margin="-8,0,0,0" Theme="{StaticResource DangerIconButtonStyle}" Content="{StaticResource Glyph.Delete}" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete attachment" AutomationProperties.Name="Delete attachment" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="AddAttachmentButton" Theme="{StaticResource AddRowButtonStyle}" Command="{Binding AddAttachmentCommand}" IsVisible="{Binding CanAttach}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="Icon" Text="{StaticResource Glyph.Add}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Add attachment" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="EditorScroll" Grid.Row="2" IsVisible="{Binding IsEditing}">
            <StackPanel Margin="{StaticResource PageGutter}">
                <StackPanel x:Name="NewItemPanel" IsVisible="{Binding IsNew}">
                    <TextBlock Classes="GroupHeader" Text="Item type" Margin="4,8,4,8" />
                    <Border Classes="Group">
                        <Border Classes="Row Edit">
                            <StackPanel>
                                <TextBlock Classes="FieldLabel" Text="Type" />
                                <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" ItemsSource="{x:Static vm:ItemViewModel.TypeChoices}" SelectedItem="{Binding SelectedType}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </StackPanel>
                <views:ItemEditView x:Name="EditView" DataContext="{Binding Editor}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
