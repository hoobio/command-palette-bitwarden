<Window
    x:Class="HoobiBitwardenCompanion.Views.ItemWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:vm="using:HoobiBitwardenCompanion.ViewModels"
    xmlns:views="using:HoobiBitwardenCompanion.Views"
    x:DataType="vm:ItemViewModel"
    Title="{Binding HeaderTitle}"
    Width="440"
    Height="620"
    MinWidth="340"
    MinHeight="320"
    WindowStartupLocation="CenterScreen"
    CanMinimize="False"
    CanMaximize="False"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="{StaticResource TitleBarHeight}"
    WindowDecorationsTheme="{StaticResource HoobiCloseOnlyDecorations}"
    Background="{DynamicResource WindowGroundBrush}">
    <Grid x:Name="Root" RowDefinitions="Auto,*" Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem
                    x:Name="AlwaysOnTopItem"
                    Header="Always on top"
                    ToggleType="CheckBox"
                    IsChecked="{Binding $parent[Window].Topmost, Mode=OneWay}"
                    Click="OnAlwaysOnTopClick">
                    <MenuItem.Icon>
                        <TextBlock Classes="Icon" Text="{StaticResource Glyph.Pin}" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <Grid
            x:Name="AppTitleBar"
            Background="Transparent"
            ColumnDefinitions="*,Auto,46"
            chrome:WindowDecorationProperties.ElementRole="User">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="24,24,8,12" IsHitTestVisible="False">
                <Border Classes="Tile Large">
                    <Panel>
                        <Image Source="{Binding Icon}" Width="32" Height="32" IsVisible="{Binding HasIcon}" />
                        <TextBlock Classes="Icon Accent" Text="{Binding TypeGlyph}" FontSize="24" HorizontalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Margin="0,2,0,0" ItemSpacing="6" LineSpacing="6">
                        <TextBlock Classes="Icon" Text="{StaticResource Glyph.Pin}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding $parent[Window].Topmost}" />
                        <Border Classes="Badge">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="OrganizationName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Organization}" />
                                <TextBlock Text="{Binding OrganizationName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="FolderName" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Folder}" />
                                <TextBlock Text="{Binding FolderName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge Accent">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="IsFavorite" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.StarFilled}" />
                                <TextBlock Text="Favourite" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsReadOnly" />
                                    <Binding Path="IsProtected" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Lock}" />
                                <TextBlock Text="Protected" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="NewItemBadge" Classes="Badge Accent" IsVisible="{Binding IsNew}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Add}" />
                                <TextBlock Text="New item" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="Badge Accent">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsEditing" />
                                    <Binding Path="!IsNew" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="BadgeIcon" Text="{StaticResource Glyph.Edit}" />
                                <TextBlock Text="Editing" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="EditButton" Classes="CaptionButton" Theme="{StaticResource CaptionButtonTheme}" Height="{StaticResource TitleBarHeight}" Content="{StaticResource Glyph.Edit}" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" IsEnabled="{Binding !IsPrompting}" ToolTip.Tip="Edit" AutomationProperties.Name="Edit" />
                <Button x:Name="DeleteButton" Classes="CaptionButton Danger" Theme="{StaticResource CaptionButtonTheme}" Height="{StaticResource TitleBarHeight}" Content="{StaticResource Glyph.Delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsReadOnly}" IsEnabled="{Binding !IsPrompting}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete" />
            </StackPanel>
        </Grid>

        <views:ItemView Grid.Row="1" Margin="24,0,0,0" />
    </Grid>
</Window>
