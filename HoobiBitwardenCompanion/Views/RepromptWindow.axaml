<views:DialogWindow
    x:Class="HoobiBitwardenCompanion.Views.RepromptWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:views="using:HoobiBitwardenCompanion.Views"
    xmlns:vm="using:HoobiBitwardenCompanion.ViewModels"
    x:DataType="vm:RepromptViewModel"
    Title="Master password required"
    Width="440"
    SizeToContent="Height"
    MinWidth="340"
    WindowStartupLocation="CenterScreen"
    CanMinimize="False"
    CanMaximize="False"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="{StaticResource TitleBarHeight}"
    WindowDecorationsTheme="{StaticResource HoobiCloseOnlyDecorations}"
    Background="{DynamicResource WindowGroundBrush}">
    <Grid RowDefinitions="48,*,Auto" Background="Transparent">
        <Grid x:Name="AppTitleBar" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="User">
            <TextBlock Text="Master password required" Margin="24,0,56,0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,0,24,12" Spacing="8">
                <TextBlock x:Name="ItemNameText" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ItemName}" IsVisible="{Binding ItemName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="Caption" TextWrapping="Wrap" Text="This item requires master password verification before you can access it." />
                <TextBlock Text="Master password" Margin="0,8,0,0" />
                <TextBox x:Name="PasswordBox" Classes="revealPasswordButton" PasswordChar="•" PlaceholderText="Master password" Text="{Binding Password, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                <Border x:Name="ErrorAlert" Classes="Alert" Classes.Danger="True" Margin="0,4,0,0" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                </Border>
                <StackPanel x:Name="BusyPanel" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsBusy}">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock x:Name="BusyText" Classes="Caption" TextWrapping="Wrap" Text="{Binding BusyText}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="24,8,24,24">
            <Button x:Name="VerifyButton" Theme="{StaticResource AccentButtonStyle}" Content="Verify" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button x:Name="HelloButton" Content="Use Windows Hello" Command="{Binding SubmitBiometricCommand}" IsVisible="{Binding WindowsHello}" IsEnabled="{Binding !IsBusy}" />
            <Button x:Name="CancelButton" Content="Cancel" IsEnabled="{Binding !IsBusy}" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</views:DialogWindow>
