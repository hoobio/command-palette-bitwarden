<UserControl
    x:Class="HoobiBitwardenCompanion.Views.GeneratorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HoobiBitwardenCompanion.ViewModels"
    x:DataType="vm:GeneratorViewModel">
    <StackPanel>
        <Border x:Name="CurrentPasswordGroup" Classes="Group" Margin="0,0,0,12" IsVisible="{Binding HasCurrentPassword}">
            <Border Classes="Row Field" DataContext="{Binding CurrentPassword}" x:DataType="vm:FieldViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="0">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Classes="FieldLabel" Text="Current password" />
                        <TextBlock x:Name="CurrentPasswordText" Text="{Binding DisplayValue}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFontFamily}" FontSize="13" LetterSpacing="1" />
                    </StackPanel>
                    <Button x:Name="PeekButton" Grid.Column="1" Theme="{StaticResource IconButtonStyle}" ToolTip.Tip="Hold to show" AutomationProperties.Name="Hold to show">
                        <Panel>
                            <TextBlock Text="{StaticResource Glyph.Eye}" IsVisible="{Binding !IsRevealed}" />
                            <TextBlock Classes="Icon Accent" Text="{StaticResource Glyph.EyeOff}" IsVisible="{Binding IsRevealed}" />
                        </Panel>
                    </Button>
                    <Button x:Name="CopyCurrentButton" Grid.Column="2" Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Copy}" Command="{Binding CopyCommand}" ToolTip.Tip="Copy" AutomationProperties.Name="Copy current password" />
                </Grid>
            </Border>
        </Border>

        <TabStrip x:Name="KindTabs" SelectedIndex="{Binding SelectedTab}">
            <TabStripItem Content="Password" />
            <TabStripItem Content="Passphrase" />
        </TabStrip>

        <Border Classes="Group" Margin="0,16,0,0">
            <Border Classes="Row Field" MinHeight="64">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="0">
                    <SelectableTextBlock x:Name="ValueText" Text="{Binding Value}" FontFamily="{StaticResource MonoFontFamily}" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="RegenerateButton" Grid.Column="1" Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Refresh}" Command="{Binding RegenerateCommand}" ToolTip.Tip="Regenerate" AutomationProperties.Name="Regenerate" />
                    <Button x:Name="CopyButton" Grid.Column="2" Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Copy}" Command="{Binding CopyCommand}" ToolTip.Tip="Copy" AutomationProperties.Name="Copy" />
                </Grid>
            </Border>
        </Border>

        <TextBlock Classes="GroupHeader" Text="Options" />
        <Border Classes="Group">
            <Panel>
                <StackPanel x:Name="PasswordOptions" Classes="Rows" IsVisible="{Binding IsPassword}">
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Length" />
                                <TextBlock Classes="Caption" Text="5 to 128 characters" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Minimum="5" Maximum="128" Increment="1" FormatString="0" Value="{Binding Length}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Uppercase (A-Z)" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" MinWidth="0" IsChecked="{Binding Uppercase}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Lowercase (a-z)" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" MinWidth="0" IsChecked="{Binding Lowercase}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Numbers (0-9)" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" MinWidth="0" IsChecked="{Binding Numbers}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Special (!@#$%^&amp;*)" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" MinWidth="0" IsChecked="{Binding Special}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch" IsVisible="{Binding Numbers}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Minimum numbers" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="9" Increment="1" FormatString="0" Value="{Binding MinNumber}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch" IsVisible="{Binding Special}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Minimum special" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Minimum="0" Maximum="9" Increment="1" FormatString="0" Value="{Binding MinSpecial}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Avoid ambiguous characters" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" MinWidth="0" IsChecked="{Binding AvoidAmbiguous}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PassphraseOptions" Classes="Rows" IsVisible="{Binding IsPassphrase}">
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Number of words" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" Minimum="3" Maximum="20" Increment="1" FormatString="0" Value="{Binding Words}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Word separator" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Width="92" HorizontalAlignment="Right" MaxLength="1" Text="{Binding Separator}" PlaceholderText="-" FontFamily="{StaticResource MonoFontFamily}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Capitalise" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" MinWidth="0" IsChecked="{Binding Capitalize}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>
                    </Border>
                    <Border Classes="Row Switch">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="Include number" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" MinWidth="0" IsChecked="{Binding IncludeNumber}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Panel>
        </Border>

        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap" Classes="Warn" Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="Caption" Margin="0,8,0,0" Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <StackPanel IsVisible="{Binding HasHistory}">
            <TextBlock Classes="GroupHeader" Text="Generator history" />
            <Border Classes="Group">
                <ItemsControl x:Name="HistoryList" Classes="Rows" ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GeneratedRowViewModel">
                            <Border Classes="Row Field">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static vm:FieldViewModel.Mask}" FontFamily="{StaticResource MonoFontFamily}" FontSize="13" LetterSpacing="1" />
                                        <TextBlock Classes="FieldLabel">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} · {1}">
                                                    <Binding Path="Label" />
                                                    <Binding Path="Created" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Theme="{StaticResource IconButtonStyle}" Content="{StaticResource Glyph.Copy}" Command="{Binding CopyCommand}" VerticalAlignment="Center" ToolTip.Tip="Copy" AutomationProperties.Name="Copy" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
