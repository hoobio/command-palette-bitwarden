<views:DialogWindow
    x:Class="HoobiBitwardenCompanion.Views.ApiKeyLoginWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:views="using:HoobiBitwardenCompanion.Views"
    xmlns:vm="using:HoobiBitwardenCompanion.ViewModels"
    x:DataType="vm:ApiKeyLoginViewModel"
    Title="Log in with your API key"
    Width="440"
    Height="440"
    MinWidth="340"
    MinHeight="380"
    WindowStartupLocation="CenterScreen"
    CanMinimize="False"
    CanMaximize="False"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="{StaticResource TitleBarHeight}"
    WindowDecorationsTheme="{StaticResource HoobiCloseOnlyDecorations}"
    Background="{DynamicResource WindowGroundBrush}">
    <Grid RowDefinitions="48,*,Auto" Background="Transparent">
        <Grid x:Name="AppTitleBar" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="User">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Classes="Icon" Text="{StaticResource Glyph.Lock}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="Log in with your API key" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,8,24,16" Spacing="8">
                <TextBlock Text="Log in with your API key" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Classes="Caption" TextWrapping="Wrap" Text="In the Bitwarden web vault, open Settings &gt; Security &gt; Keys and select View API key." />
                <TextBlock Text="Client ID" Margin="0,8,0,0" />
                <TextBox x:Name="ClientIdBox" PlaceholderText="user.xxxxxxxx-..." Text="{Binding ClientId, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                <TextBlock Text="Client secret" />
                <TextBox x:Name="ClientSecretBox" Classes="revealPasswordButton" PasswordChar="•" PlaceholderText="Client secret" Text="{Binding ClientSecret, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                <Border x:Name="ErrorAlert" Classes="Alert" Classes.Danger="True" Margin="0,4,0,0" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="24,8,24,24">
            <Button x:Name="LoginButton" Theme="{StaticResource AccentButtonStyle}" Content="Log in" Command="{Binding SubmitCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button x:Name="CancelButton" Content="Cancel" IsEnabled="{Binding !IsBusy}" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</views:DialogWindow>
